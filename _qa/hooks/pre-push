#!/bin/sh
# Canonical pre-push gate. THIS file is the versioned source of truth.
#
# Install it in a checkout with:
#     cp _qa/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Why it lives here: .git/hooks is not versioned, so on 2026-08-03 this gate
# existed in the Documents checkout and was simply absent from the dev one.
# Every push from dev ran with the gates advisory rather than enforced, which
# means the folder you happened to be sitting in decided whether a secret could
# reach the public site. A gate that depends on your working directory is not a
# gate. Git cannot version .git/hooks itself, so the honest fix is: keep the
# real script in the repo where a diff can see it, and install it per checkout.
#
# Bypass in a real emergency with: git push --no-verify
#
# Note that seo_audit and autoqa are REGRESSION gates -- they fail when the
# defect count rises above the recorded baseline, not when it is merely
# non-zero. Both baselines are currently 0, so any new defect blocks.
# The sweep runs on every push and had, until 2026-08-09, never been observed
# failing -- which turned out to hide a hole: its key pattern could not match
# `sk-ant-...`, so an Anthropic key was invisible to it. A gate nobody has seen
# go red is not evidence. This proves it can still catch a planted key AND still
# ignores ordinary page copy, before it is trusted to judge the real tree.
echo "Security sweep: proving the gate can still fail..."
python _qa/test_security_sweep.py || {
  echo ""
  echo "PUSH BLOCKED — the secret scanner can no longer catch a planted key,"
  echo "or has started flagging ordinary copy. Fix the patterns, not the test."
  exit 1
}
echo "Security sweep: scanning public surface for secrets..."
python _qa/security_sweep.py || {
  echo ""
  echo "PUSH BLOCKED — a secret or internal ID would go public. Redact/rotate first."
  exit 1
}
# AutoQA's own controls -- and until 2026-08-18 NOTHING RAN THEM. The 12 pinned
# cases guarding the client-base rule, and the check_deploy cases added the same
# day, sat in the tree executed by no gate and no job: the identical shape as
# skeleton's assertion-free harness and vouch's suite that was red for six days.
# A control nobody runs is a control that does not exist, so it runs first, for
# the same reason the security sweep's does.
echo "AutoQA controls: proving the claim and deploy checks can still fail..."
python _qa/test_autoqa.py || {
  echo ""
  echo "PUSH BLOCKED — autoqa's own checks no longer behave. Either the claim"
  echo "patterns stopped catching a real overclaim, or check_deploy started"
  echo "crying wolf on normal build churn. Fix the check, not the test."
  exit 1
}
echo "AutoQA: checking artifacts before push..."
# --record: the push is the ONLY moment allowed to move the baseline, and only
# when the gate passes. Without it these audits wrote history on every run, so
# running one twice with nothing fixed turned the defect into the new normal and
# the second run exited 0. Any other invocation -- yours, or the nightly job --
# is a read-only diagnostic now.
python _qa/autoqa.py --fast --record || {
  echo ""
  echo "PUSH BLOCKED — defect count regressed. Fix, or push with --no-verify."
  exit 1
}
# A tool that cannot read a file is broken no matter how clean the rest of the
# site looks. On 2026-08-12 a scope bug in the shared reader shipped to five live
# tools -- a ReferenceError on every file drop -- and every gate here stayed
# green, because not one of them opened a spreadsheet. This one does.
echo "Reader gate: checking the shipped pages can still read a spreadsheet..."
python _qa/test_reader.py || {
  echo ""
  echo "PUSH BLOCKED - the shipped xlsx reader is broken. Fix, or push with --no-verify."
  exit 1
}
# The reader gate above proves the pages can OPEN a spreadsheet. It says nothing
# about whether what skeleton concludes from one is right, and skeleton's own
# harness could not answer that either: until 2026-08-15 it carried no assertions
# and exited 0 even with findings() replaced by `return []` (measured, not
# assumed). It also ran nowhere -- the only reference to it in the tree was a
# message telling a human to run it. Both halves fixed here: drift, then logic.
echo "Skeleton: checking the live page matches engine.js, and its logic holds..."
python ../skeleton/build.py >/dev/null || {
  echo ""
  echo "PUSH BLOCKED - /skeleton/ has drifted from engine.js. Run:"
  echo "    python ../skeleton/build.py --write"
  exit 1
}
(cd ../skeleton && node verify.js) || {
  echo ""
  echo "PUSH BLOCKED - skeleton's engine suite failed. Fix the engine, not the test."
  exit 1
}
# A person and a role are IDENTITIES. Measured 2026-08-17: one nurse covering a
# whole week, spelled five ways, made "only one person can cover Nurse" and
# "54h in a week" BOTH disappear -- an all-clear over a real risk, from a page
# that had no test of any kind. The controls matter more than the assertions
# here: a fix that merged everyone would pass the first half and be worse.
echo "Shift coverage: checking a person is an identity, not a spelling..."
python _qa/test_shift_coverage.py || {
  echo ""
  echo "PUSH BLOCKED - /shift-coverage-check/ groups people or roles wrongly."
  echo "Either it loses someone to a spelling, or it merged two real people."
  exit 1
}
# /check/ is the only tool that puts MONEY on a finding, and the number comes
# from joining two files on a shared column. Measured 2026-08-17: spelling the
# job IDs in lower case turned "$800 of finished work nobody invoiced" into NO
# FINDING -- and it still reported a successful join, because the only overlap
# left was the two AMOUNT columns. An amount is not an identity, and joining on
# one turns "these files do not line up" into a confident all-clear.
echo "Check: does the dollar figure survive how the IDs are spelled..."
python _qa/test_check_reconcile.py || {
  echo ""
  echo "PUSH BLOCKED - /check/ reconciles two files wrongly."
  echo "Either a spelling difference hides real unbilled work, or it invented a join."
  exit 1
}
# _brand/tokens.py promises "a new tool CANNOT be off-brand, because it does not
# declare its own colours". Measured 2026-08-16: nothing enforced that, and the
# site was already 33 pages on a legacy palette and 3 on tokens.py. Which way to
# unify is a design decision and NOT this gate's business; inventing a third
# palette on the way there is. The baseline accepts today's split and blocks new
# hand-picked colour. --record cannot move it on a run that found something.
echo "Palette: checking no page invents a colour..."
python _qa/palette_audit.py --record || {
  echo ""
  echo "PUSH BLOCKED - a page uses a colour from no known source."
  echo "Use a token from _brand/tokens.py, or add it to the palette deliberately."
  exit 1
}
echo "SEO audit: checking metadata/schema/sitemap/NAP before push..."
python _qa/seo_audit.py --record || {
  echo ""
  echo "PUSH BLOCKED — SEO defect count regressed. Fix, or push with --no-verify."
  exit 1
}
# The other three gates check STRUCTURE. This one checks whether what the pages
# SAY is still true, by re-deriving each claim from its source of truth. It is
# last because it is the slowest (it collects a test suite), and blocking
# because shipping a page that overclaims is worse than shipping a broken tag.
echo "Claim audit: re-deriving every factual claim the site makes..."
python _qa/claim_audit.py || {
  echo ""
  echo "PUSH BLOCKED — a published claim no longer matches its source of truth."
  echo "Fix the page, or fix the claim if the LEDGER is the thing that is wrong."
  exit 1
}
# Claim audit asks whether what the pages SAY is true. This asks the one thing
# no other gate does: when a visitor does what the page tells them to do, do
# they get the thing? /free-staffing-commission-tracker/ promised a sheet
# "yours to copy" for three and a half weeks with no sheet in existence, and
# every other gate passed the entire time.
echo "Promise audit: does every page that offers an artifact actually have one..."
python _qa/promise_audit.py || {
  echo ""
  echo "PUSH BLOCKED — a page promises an artifact it cannot hand over."
  echo "Build the artifact, or stop promising it. Do not soften the gate."
  exit 1
}

# The public /log/ is GENERATED from the private dev/BUILD-LOG.html, which other
# sessions append to daily. Nothing stops a push from shipping a version that is
# days behind the log it claims to mirror — a page quietly stating stale facts is
# the exact failure this company sells against, so it cannot be the one thing we
# ship un-checked. Regenerate and compare; the builder is fail-closed on privacy.
echo "Public log: checking /log/ is in step with the private build log..."
python _brand/build_log_page.py >/dev/null || {
  echo ""
  echo "PUSH BLOCKED — the public log builder refused to write."
  echo "Usually means a blocked term (job lane / personal projects) reached the output."
  exit 1
}
if ! git diff --quiet -- log/index.html; then
  echo ""
  echo "PUSH BLOCKED — /log/ was stale and has just been regenerated."
  echo "Review the diff, then: git add log/index.html && git commit --amend --no-edit"
  echo "(or commit it separately) and push again."
  exit 1
fi

# /proof/ai/ is GENERATED from the attest ledger, which grows every time a
# scheduled AI job runs. A published record of what our AI did, silently frozen
# at the day it was created while presenting itself as current, would be a
# worse version of the exact failure it exists to expose — and it would be our
# own tool lying about our own tools. Same treatment as /log/.
echo "AI record: checking /proof/ai/ is in step with the ledger..."
python _brand/build_proof_ai_page.py >/dev/null || {
  echo ""
  echo "PUSH BLOCKED — the /proof/ai/ builder refused to write."
  echo "It fails closed if a username or local path reached the page."
  exit 1
}
# The page stamps its own generation time, so a naive diff reports drift on
# EVERY rebuild and the guard blocks every push forever. A guard that always
# fires is one somebody deletes — the same muted-guard failure watchpost and
# canary each hit. So compare substance, and ignore the clock.
ai_drift=$(git diff -U0 -- proof/ai/index.html \
           | grep '^[+-]' | grep -v '^[+-][+-]' | grep -vc 'Generated 20' || true)
if [ "${ai_drift:-0}" -gt 0 ]; then
  echo ""
  echo "PUSH BLOCKED — /proof/ai/ was stale and has just been regenerated."
  echo "Review the diff, then: git add proof/ai/index.html && git commit --amend --no-edit"
  echo "(or commit it separately) and push again."
  exit 1
fi
# Only the timestamp moved: discard that churn rather than committing noise.
git checkout -- proof/ai/index.html 2>/dev/null || true
